# Copy to .env.local for local development (netlify dev / next dev).
# On Netlify itself, set these under Site settings -> Environment variables.

# Signs session cookies (HS256). Generate with: openssl rand -base64 32
SESSION_SECRET=

# Resend (https://resend.com) — real email delivery for verification codes
# and password resets. Without this set, emails are logged to the server
# console instead of sent — everything else still works for local testing.
# Using Resend's shared onboarding@resend.dev domain only delivers to your
# own Resend account email until you verify a domain of your own.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Your Name <you@yourdomain.example>"

# DATABASE_URL / NETLIFY_DATABASE_URL are provisioned automatically by
# @netlify/database on `netlify dev` or deploy — nothing to set here.
